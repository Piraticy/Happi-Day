    },
    {
      "name": "Reason field",
      "kind": "input",
      "refersTo": "reason-field",
      "description": "Optional personal words in a pale rounded field.",
      "html": "<label class=\"ds-field-label\" for=\"ds-reason\">Your own reason</label><textarea class=\"ds-field\" id=\"ds-reason\" rows=\"2\" placeholder=\"Or put it in your own words\u2026\" maxlength=\"500\"></textarea>",
      "css": ".ds-field-label{display:block;margin-bottom:10px;color:var(--ink,#3e2248);font:500 12px \"DM Sans Variable\",sans-serif}.ds-field{display:block;resize:vertical;min-height:92px;width:100%;padding:14px 16px;border:1px solid #cbb4aa;border-radius:12px;background:#fff9f2;color:var(--ink,#3e2248);font:14px/1.6 \"DM Sans Variable\",sans-serif;caret-color:var(--coral,#b94131)}.ds-field::placeholder{color:var(--muted,#7a626d)}.ds-field:focus-visible{outline:3px solid var(--coral,#b94131);outline-offset:4px}"
    },
    {
      "name": "Reason chip",
      "kind": "chip",
      "refersTo": "reason-chip",
      "description": "A suggested reason with an explicit pressed state.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"false\">Work</button> <button class=\"ds-chip\" aria-pressed=\"true\">Me time</button>",
      "css": ".ds-chip{min-height:40px;padding:9px 16px;border:1px solid #cbb4aa;border-radius:24px;background:transparent;color:var(--ink,#3e2248);font:12px \"DM Sans Variable\",sans-serif;cursor:pointer}.ds-chip:hover{background:var(--surface,#fbe9dc)}.ds-chip[aria-pressed=\"true\"]{background:var(--ink,#3e2248);border-color:var(--ink,#3e2248);color:var(--ground,#fff6ed)}.ds-chip:focus-visible{outline:3px solid var(--coral,#b94131);outline-offset:4px}"
    },
