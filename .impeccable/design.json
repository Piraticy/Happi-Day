      "html": "<nav class=\"ds-nav\" aria-label=\"Demo navigation\"><button aria-current=\"page\">Today</button><button>History</button><button>Your rhythm</button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:7px;padding:20px;background:var(--ink,#3e2248);border-radius:12px}.ds-nav button{padding:15px 18px;border:0;border-radius:12px;background:transparent;color:#e4d1e3;text-align:left;font:14px \"DM Sans Variable\",sans-serif;cursor:pointer}.ds-nav button:hover{background:#523159}.ds-nav button[aria-current=\"page\"]{background:#60416a;color:var(--ground,#fff6ed)}.ds-nav button:focus-visible{outline:3px solid #f4ad94;outline-offset:4px}"
